# opus-exclusive build config for hippy/hipsci
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/node/bin:$PATH"
export BOB_MODEL_ESCALATION_LADDER=opus
# Force every model alias to resolve to opus on the AMD gateway
export ANTHROPIC_DEFAULT_OPUS_MODEL=Claude-Opus-4.7
export ANTHROPIC_DEFAULT_SONNET_MODEL=Claude-Opus-4.7
export ANTHROPIC_DEFAULT_HAIKU_MODEL=Claude-Opus-4.7
export ANTHROPIC_MODEL=Claude-Opus-4.7
# BOB_CI_MODE removed 2026-07-02: it gate-blocks on synth-AC noise; non-TTY auto-select is preferred
# export BOB_CI_MODE=1
export BOB_SUB_AGENT_MAX_TURNS=100
